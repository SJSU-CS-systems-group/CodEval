#command=docker run -u $UID -i -v SUBMISSIONS:/submissions autograder-java bash -c "cd /submissions; EVALUATE"
# -u runs the evaluation as the invoking user so files written into the
# submission belong to them; --group-add docker lets it talk to a daemon started
# with start-dockerd (see the codeval files that need Docker). HOME is set
# because the uid usually has no passwd entry in the image.
command=exec docker run -i --pids-limit 4000 --privileged -u $(id -u):$(id -g) --group-add docker -e HOME=/tmp -v dockercache:/var/lib/docker -v SUBMISSIONS:/submissions --rm autograder-java bash -c "ulimit -f 10000000; cd /submissions; EVALUATE"
